# ===================================================================
# Schooly Backend Environment Configuration (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the 'schooly-backend' directory:
#    cp .env.example .env
# 2. Fill in the values for your environment.
# 3. DO NOT commit your actual '.env' file into Git!
# ===================================================================

# -------------------------------------------------------------------
# Server & Runtime Configuration
# -------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -------------------------------------------------------------------
# Database Configuration (PostgreSQL / Neon Tech)
# Local development (Docker Compose):
#   SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/schooly_db
#   SPRING_DATASOURCE_USERNAME=postgres
#   SPRING_DATASOURCE_PASSWORD=password123
# Cloud (Neon Tech Pooler):
# -------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/neondb?sslmode=require&channelBinding=require&socketTimeout=30&tcpKeepAlive=true&prepareThreshold=5&preparedStatementCacheQueries=256&preparedStatementCacheSizeMiB=5&currentSchema=public
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_db_password_here

# Hibernate DDL & Flyway Migration Settings
# Options for DDL: 'validate' (recommended for production), 'update' (development)
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=false

# HikariCP Connection Pool (sized for free-tier / connection limit stability)
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2

# -------------------------------------------------------------------
# Security & JWT Configuration
# Generate a secure 256-bit (at least 32 characters) random key
# -------------------------------------------------------------------
APP_JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
APP_JWT_ACCESS_TOKEN_EXPIRATION_MS=86400000
APP_JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# -------------------------------------------------------------------
# Centralized File Storage (AWS S3)
# Set APP_STORAGE_PROVIDER to 's3' for AWS S3, or 'local' for local disk
# -------------------------------------------------------------------
APP_STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
AWS_S3_BUCKET=schooly-production-files
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# -------------------------------------------------------------------
# Payment Gateway (Razorpay)
# -------------------------------------------------------------------
RAZORPAY_ENABLED=true
RAZORPAY_SANDBOX_MODE=true
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_MERCHANT_NAME=Schooly Platform
